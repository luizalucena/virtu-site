# ============================================================
# VIRTÙ — Security & Performance Headers
# Pilar 1 — Cache | Pilar 5 — Segurança HTTP
#
# NOTA: Este arquivo é aplicado automaticamente por:
#   • Netlify  → suportado nativamente
#   • Cloudflare Pages → suportado nativamente
#   • GitHub Pages → NÃO suportado (use meta tags no HTML)
#
# Para GitHub Pages, os headers equivalentes estão como
# <meta http-equiv> em cada página HTML do site.
# ============================================================

# ── PILAR 1: CACHE DE ASSETS ESTÁTICOS ───────────────────────
# JavaScript — cache por 1 ano (imutável pois versão muda por hash de conteúdo)
/js/*
  Cache-Control: public, max-age=31536000, immutable

# CSS — cache por 1 ano
/css/*
  Cache-Control: public, max-age=31536000, immutable

# Imagens locais — cache por 7 dias (podem mudar em atualizações de produto)
/images/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# Fontes — cache por 1 ano (imutáveis)
*.woff2
  Cache-Control: public, max-age=31536000, immutable

*.woff
  Cache-Control: public, max-age=31536000, immutable

# Arquivos HTML — sem cache (sempre busca versão atual)
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# Raiz do site
/
  Cache-Control: public, max-age=0, must-revalidate

# sitemap e robots — cache de 1 dia
/sitemap.xml
  Cache-Control: public, max-age=86400

/robots.txt
  Cache-Control: public, max-age=86400

# ── PILAR 5: SEGURANÇA (todas as rotas) ──────────────────────
/*
  # Política de referência — limita informação enviada ao abrir links
  Referrer-Policy: strict-origin-when-cross-origin

  # Impede MIME-type sniffing (ataques de tipo de conteúdo)
  X-Content-Type-Options: nosniff

  # Impede o site de ser embutido em iframes de outros domínios (clickjacking)
  X-Frame-Options: DENY

  # HSTS — força HTTPS por 1 ano, inclui subdomínios, elegível para preload
  # ATENÇÃO: só ativar quando HTTPS estiver 100% funcional em produção
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

  # Restringe APIs modernas de rastreio/hardware desnecessárias
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=(), payment=()

  # Content Security Policy (CSP) — controla origens permitidas
  # Atualizar se novas CDNs ou serviços forem adicionados
  # connect-src inclui viacep.com.br (autocompletar de CEP no checkout — js/checkout.js)
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https://oxivtnuxnghpddwawfdr.supabase.co https://lh3.googleusercontent.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://oxivtnuxnghpddwawfdr.supabase.co wss://oxivtnuxnghpddwawfdr.supabase.co https://viacep.com.br; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self';
